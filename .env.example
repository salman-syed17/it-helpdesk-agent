# Copy this file to .env and paste your real key after the equals sign.
# .env is ignored by Git, so your key stays on your machine.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Your ServiceNow developer instance (developer.servicenow.com).
# Use the base address only, with no login details in it.
SERVICENOW_INSTANCE=https://dev12345.service-now.com

# Sign in as a dedicated machine user with only the itil role, not as admin.
SERVICENOW_USERNAME=helpdesk.agent
SERVICENOW_PASSWORD='your-password-here'

# Optional. Remove the leading # to use them.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Practice tickets held in memory instead of ServiceNow:
# DEMO_MODE=1
